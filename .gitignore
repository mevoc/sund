# --- Sund runtime artifacts ---
# The database file and any backups — never commit operator data.
*.db
*.db-wal
*.db-shm
sund.db*
backup/

# Compiled server binary (produced by `go build`)
/sund
/sund-*
dist/

# --- Go ---
# Test binaries and coverage
*.test
*.out
coverage.*

# --- Python (beaconsim / system suite) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
# uv-managed environment (the lockfile uv.lock IS committed)

# --- Claude Code ---
# Local, machine-specific settings and permission grants (not shared).
.claude/settings.local.json
.claude/*.tmp.*

# --- Deployment ---
# Local compose overrides / env; .env.example is committed as the template.
.env
compose.override.yaml
compose.override.yml

# TLS material generated at runtime (sund serve/cert --tls-dir)
certs/
*.crt
*.key
*.pem

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# Copy to .env and edit. These configure the compose deployment (compose reads
# .env automatically). Container-internal settings (SUND_ADDR, SUND_DB) already
# have sensible defaults baked into the image and are set in compose.yaml.

# Which image to run. Pin to a specific tag (e.g. :sha-<commit>) for reproducible
# deploys instead of :latest.
SUND_IMAGE=ghcr.io/mevoc/sund:latest

# Host port to publish the relay on. The container always listens on 5870.
SUND_PORT=5870
